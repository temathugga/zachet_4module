<Window x:Class="avtorizacia.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:avtorizacia"
        mc:Ignorable="d"
              WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel>
            <TextBlock Text="Добро пожаловать!" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,150,0,0" FontSize="50"/>
            <Button x:Name="exitButton" Content="Выйти" Margin="0,250,0,10" Height="35" Width="225" Click="exitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>